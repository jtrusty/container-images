{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  dependencyDashboard: true,
  // Keep Renovate's PRs current with main after every merge, so each one is
  // tested against what it will land on. CI here runs on GitHub-hosted
  // runners, free for a public repo. main doesn't require up-to-date
  // branches to merge; this keeps the bot's PRs fresh without that rule.
  rebaseWhen: "behind-base-branch",
  customManagers: [
    {
      // The upstream of every image: a renovate comment, then VERSION and DIGEST.
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\nARG VERSION=(?<currentValue>\\S+)\\nARG DIGEST=(?<currentDigest>\\S+)",
      ],
    },
    {
      // Tool versions used during a build (e.g. Playwright's dependency installer).
      customType: "regex",
      managerFilePatterns: ["/(^|/)Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG [A-Z_]+_VERSION=(?<currentValue>\\S+)\\n",
      ],
    },
  ],
  packageRules: [
    {
      // One PR per image, titled by its directory, so each upstream change is reviewed on its own.
      matchFileNames: ["apps/**"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessagePrefix: "{{parentDir}}:",
    },
    {
      // The runner's managed Python stays on 3.10 (what the consuming projects
      // require); only patch releases are proposed.
      matchDepNames: ["python"],
      matchDatasources: ["python-version"],
      allowedVersions: "<3.11",
    },
    {
      // supergateway 4.x exits as soon as stdin closes, which in a container
      // is immediately. Hold 3.x until 4.x can run without an open stdin.
      matchPackageNames: ["supergateway"],
      allowedVersions: "<4",
    },
    {
      // Tools downloaded with a pinned *_SHA256 in the Dockerfile. Renovate can
      // bump the version but not the checksum, so these PRs need a manual step.
      matchDepNames: ["cli/cli", "sheeki03/tirith", "kubernetes/kubernetes"],
      addLabels: ["checksum-update"],
      prBodyNotes: [
        "**Manual step:** update the matching `*_SHA256` build argument in the Dockerfile to the new release's published checksum. The build fails until it matches.",
      ],
    },
  ],
}
